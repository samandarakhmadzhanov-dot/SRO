
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Сервис записи на консультацию</title>
    <link rel="stylesheet" href="сро.css">
</head>
<body>

<header>
    <h1>Сервис записи на консультацию</h1>
    <p>Запись студентов к преподавателям</p>
</header>

<main>
    <section class="stats">
        <div class="stat">
            <h3 id="totalSlots">0</h3>
            <p>Всего слотов</p>
        </div>
        <div class="stat">
            <h3 id="freeSlots">0</h3>
            <p>Свободно</p>
        </div>
        <div class="stat">
            <h3 id="totalRequests">0</h3>
            <p>Заявок</p>
        </div>
    </section>

    <section class="panel">
        <h2>Расписание консультаций</h2>
        <div id="schedule" class="schedule"></div>
    </section>

    <section class="panel">
        <h2>Записаться на консультацию</h2>

        <form id="bookingForm">
            <label for="student">Имя студента</label>
            <input type="text" id="student" maxlength="100"
                   placeholder="Введите имя" required>

            <label for="topic">Тема консультации</label>
            <input type="text" id="topic" maxlength="100"
                   placeholder="Например, Python" required>

            <label for="teacher">Преподаватель</label>
            <select id="teacher" required>
                <option value="">Выберите преподавателя</option>
                <option value="Иванов">Иванов</option>
                <option value="Петров">Петров</option>
            </select>

            <label for="date">Дата консультации</label>
            <input type="date" id="date" required>

            <label for="start">Время начала</label>
            <input type="time" id="start" required>

            <label for="end">Время окончания</label>
            <input type="time" id="end" required>

            <button type="submit">Записаться</button>
        </form>

        <p id="message" role="status" aria-live="polite"></p>
    </section>

    <section class="panel">
        <h2>Заявки студентов</h2>

        <input type="text" id="search"
               placeholder="Поиск по имени студента">

        <div id="requests"></div>
    </section>
</main>

<footer>
    <p>Учебный проект по технологии программирования</p>
</footer>

<script src="сро.js"></script>
</body>
</html>
